---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | TAYCO LLC — Astro 5 Enterprise Architecture</title>
    <style is:global>
      :root {
        --navy-deep: #08121f;
        --navy-primary: #0f2040;
        --navy-mid: #142b54;
        --gold: #c9a84c;
        --gold-soft: rgba(201, 168, 76, 0.18);
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #08121f;
        color: #f8fafc;
        line-height: 1.5;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      .topbar {
        background: #0f2040;
        border-bottom: 1px solid rgba(201, 168, 76, 0.35);
        padding: 0.9rem 1.5rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .brand-title {
        color: #c9a84c;
        font-weight: 900;
        font-size: 1.25rem;
        letter-spacing: 0.03em;
      }
      .badge {
        background: rgba(201, 168, 76, 0.18);
        color: #c9a84c;
        border: 1px solid rgba(201, 168, 76, 0.45);
        padding: 0.25rem 0.65rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
      }
      .nav-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
      }
      .btn-gold {
        background: #c9a84c;
        color: #0f2040;
        font-weight: 800;
        padding: 0.55rem 1.1rem;
        border-radius: 0.6rem;
        font-size: 0.85rem;
      }
      .btn-outline {
        border: 1px solid rgba(201, 168, 76, 0.5);
        color: #f8fafc;
        font-weight: 700;
        padding: 0.55rem 1rem;
        border-radius: 0.6rem;
        font-size: 0.85rem;
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="brand">
        <span class="brand-title">TAYCO LLC</span>
        <span class="badge">⚡ Astro 5 Islands + Takeoff Pro v5.0</span>
      </div>
      <nav class="nav-links">
        <a href="/astro-preview/index.html" class="btn-outline">🏠 Split Hero Astro 5</a>
        <a href="/portal" class="btn-gold">🔐 Multi-Tenant Portal &amp; Invitations →</a>
        <a href="/estimate" class="btn-outline">🧮 Instant Cost Estimator</a>
        <a href="/" class="btn-outline">↩ Back to Main App</a>
      </nav>
    </header>
    <slot />
  </body>
</html>
