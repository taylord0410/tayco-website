---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en" data-surface="mineral" data-atmosphere="gold">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | TAYCO LLC — Umbra Digital Matter Command Hub</title>
    <style is:global>
      :root {
        --navy-deep: #060d18;
        --navy-primary: #0b1729;
        --navy-mid: #122442;
        --accent-primary: #c9a84c;
        --accent-glow: rgba(201, 168, 76, 0.24);
        --accent-border: rgba(201, 168, 76, 0.42);
        --surface-card: rgba(12, 24, 44, 0.88);
        --surface-blur: 14px;
        --font-serif: Georgia, "Times New Roman", serif;
        --font-mono: "Cascadia Code", "JetBrains Mono", Consolas, monospace;
        --font-sans: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      html[data-atmosphere="gold"] {
        --accent-primary: #c9a84c;
        --accent-glow: rgba(201, 168, 76, 0.24);
        --accent-border: rgba(201, 168, 76, 0.44);
      }
      html[data-atmosphere="emerald"] {
        --accent-primary: #34d399;
        --accent-glow: rgba(52, 211, 153, 0.22);
        --accent-border: rgba(52, 211, 153, 0.44);
      }
      html[data-atmosphere="glacier"] {
        --accent-primary: #38bdf8;
        --accent-glow: rgba(56, 189, 248, 0.22);
        --accent-border: rgba(56, 189, 248, 0.44);
      }

      html[data-surface="mineral"] {
        --surface-card: rgba(11, 22, 40, 0.92);
        --surface-blur: 10px;
      }
      html[data-surface="crystal"] {
        --surface-card: rgba(18, 36, 66, 0.58);
        --surface-blur: 24px;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--font-sans);
        background: var(--navy-deep);
        color: #f8fafc;
        line-height: 1.55;
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      /* Umbra Atmospheric Lobes & Radial Contours */
      .umbra-stage {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
      }

      .ambient-lobe {
        position: absolute;
        border-radius: 999px;
        filter: blur(85px);
        opacity: 0.55;
        transition: background 0.4s ease;
      }

      .ambient-lobe.lobe-primary {
        width: 540px;
        height: 540px;
        top: -160px;
        left: -120px;
        background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
      }

      .ambient-lobe.lobe-secondary {
        width: 620px;
        height: 620px;
        bottom: -220px;
        right: -140px;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.16) 0%, transparent 72%);
      }

      .ambient-contours {
        position: absolute;
        inset: 0;
        background-image:
          radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
          repeating-radial-gradient(
            circle at 80% 15%,
            transparent 0,
            transparent 48px,
            rgba(201, 168, 76, 0.035) 49px,
            transparent 50px
          );
        background-size: 36px 36px, 100% 100%;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(9, 19, 36, 0.86);
        backdrop-filter: blur(18px);
        border-bottom: 1px solid var(--accent-border);
        padding: 0.85rem 1.5rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.8rem;
      }

      .brand-title {
        color: var(--accent-primary);
        font-weight: 900;
        font-size: 1.2rem;
        letter-spacing: 0.04em;
      }

      .serif-italic {
        font-family: var(--font-serif);
        font-style: italic;
        font-weight: 400;
      }

      .mono-eyebrow {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent-primary);
      }

      .badge {
        background: var(--accent-glow);
        color: var(--accent-primary);
        border: 1px solid var(--accent-border);
        padding: 0.24rem 0.68rem;
        border-radius: 999px;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      .umbra-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
      }

      .control-pill-group {
        display: inline-flex;
        align-items: center;
        background: rgba(6, 13, 24, 0.75);
        border: 1px solid rgba(148, 163, 184, 0.25);
        border-radius: 999px;
        padding: 0.18rem;
        gap: 0.2rem;
      }

      .control-pill-btn {
        background: transparent;
        border: none;
        color: #cbd5e1;
        font-family: var(--font-mono);
        font-size: 0.68rem;
        padding: 0.26rem 0.6rem;
        border-radius: 999px;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .control-pill-btn.active {
        background: var(--accent-primary);
        color: #060d18;
        font-weight: 800;
      }

      .nav-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        align-items: center;
      }

      .btn-gold {
        background: var(--accent-primary);
        color: #060d18;
        font-weight: 800;
        padding: 0.52rem 1.05rem;
        border-radius: 0.6rem;
        font-size: 0.82rem;
        transition: transform 0.18s ease;
      }

      .btn-outline {
        border: 1px solid var(--accent-border);
        color: #f8fafc;
        font-weight: 700;
        padding: 0.52rem 0.95rem;
        border-radius: 0.6rem;
        font-size: 0.82rem;
      }

      .bento-card {
        position: relative;
        background: var(--surface-card);
        backdrop-filter: blur(var(--surface-blur));
        border: 1px solid var(--accent-border);
        border-radius: 1.1rem;
        padding: 1.5rem;
        overflow: hidden;
        transition: transform 0.22s ease, border-color 0.22s ease;
      }

      .preview-orbits {
        position: absolute;
        right: -36px;
        top: -36px;
        width: 150px;
        height: 150px;
        border-radius: 999px;
        border: 1px dashed rgba(201, 168, 76, 0.26);
        pointer-events: none;
      }

      .preview-orbits::after {
        content: "";
        position: absolute;
        inset: 22px;
        border-radius: 999px;
        border: 1px solid rgba(56, 189, 248, 0.2);
      }

      main {
        position: relative;
        z-index: 2;
      }
    </style>
  </head>
  <body>
    <div class="umbra-stage" aria-hidden="true">
      <div class="ambient-lobe lobe-primary"></div>
      <div class="ambient-lobe lobe-secondary"></div>
      <div class="ambient-contours"></div>
    </div>

    <header class="topbar">
      <div class="brand">
        <span class="brand-title">TAYCO <span class="serif-italic">Umbra</span></span>
        <span class="badge">⚡ Astro 5 Islands · Digital Matter v2.0</span>
      </div>

      <div class="umbra-controls" aria-label="Umbra Digital Matter Material and Atmosphere Controls">
        <div class="control-pill-group" role="group" aria-label="Physical Material Selector">
          <button type="button" class="control-pill-btn active" data-set-surface="mineral">
            🪨 Mineral
          </button>
          <button type="button" class="control-pill-btn" data-set-surface="crystal">
            💎 Crystal
          </button>
        </div>

        <div class="control-pill-group" role="group" aria-label="Chromatic Atmosphere Selector">
          <button type="button" class="control-pill-btn active" data-set-atmosphere="gold">
            Gold
          </button>
          <button type="button" class="control-pill-btn" data-set-atmosphere="emerald">
            Emerald
          </button>
          <button type="button" class="control-pill-btn" data-set-atmosphere="glacier">
            Glacier
          </button>
        </div>
      </div>

      <nav class="nav-links">
        <a href="/astro-preview/index.html" class="btn-outline">🏠 Command Hub</a>
        <a href="/astro-preview/portal/index.html" class="btn-gold">🔐 Multi-Tenant Portal →</a>
        <a href="/portal" class="btn-outline">⚡ Live Next.js Suite</a>
        <a href="/" class="btn-outline">↩ Main Website</a>
      </nav>
    </header>

    <slot />

    <script is:inline>
      (function () {
        const root = document.documentElement;
        document.querySelectorAll("[data-set-surface]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const val = btn.getAttribute("data-set-surface") || "mineral";
            root.setAttribute("data-surface", val);
            document.querySelectorAll("[data-set-surface]").forEach((b) =>
              b.classList.toggle("active", b === btn)
            );
          });
        });
        document.querySelectorAll("[data-set-atmosphere]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const val = btn.getAttribute("data-set-atmosphere") || "gold";
            root.setAttribute("data-atmosphere", val);
            document.querySelectorAll("[data-set-atmosphere]").forEach((b) =>
              b.classList.toggle("active", b === btn)
            );
          });
        });
      })();
    </script>
  </body>
</html>
