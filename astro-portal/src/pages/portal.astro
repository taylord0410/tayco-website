---
import TaycoLayout from "../layouts/TaycoLayout.astro";

const invitations = [
  {
    code: "INV-TAYCO-FULL-SUITE",
    role: "TENANT_ADMIN",
    ratio: "6/6 Modules Enabled",
    recipient: "TAYCO LLC Executive Board & Master Admin",
    modules: ["Takeoff Pro", "CRM & Bids", "Payroll WH-347", "QuickBooks ERP", "9-State Tax", "Investor Portal"],
  },
  {
    code: "INV-DEMO-CRM-TAKEOFF",
    role: "ESTIMATOR_SALES_DEMO",
    ratio: "2/6 Modules Enabled",
    recipient: "Invited Commercial Client / Estimator Showcase",
    modules: ["Takeoff Pro", "CRM & Bids"],
  },
  {
    code: "INV-CPA-FINANCE-TAX",
    role: "CPA_ACCOUNTING_AUDITOR",
    ratio: "3/6 Modules Enabled",
    recipient: "External CPA & Multi-State Tax Audit Firm",
    modules: ["Payroll WH-347", "QuickBooks ERP", "9-State Tax"],
  },
  {
    code: "INV-INVESTOR-BOARD",
    role: "INVESTOR_PARTNER",
    ratio: "3/6 Modules Enabled",
    recipient: "Midwest Commercial REIT & Turnkey Partners",
    modules: ["CRM & Bids", "QuickBooks ERP", "Investor Portal"],
  },
];
---
<TaycoLayout title="Multi-Tenant Invitation Console — Umbra Command Hub">
  <main style="max-width: 1180px; margin: 0 auto; padding: 2.25rem 1.5rem;">
    <section class="bento-card" style="padding: 2.2rem; margin-bottom: 1.5rem;">
      <div class="preview-orbits"></div>
      <span class="badge">🔐 Module-Scoped Multi-Tenant Access Control</span>
      <p class="mono-eyebrow" style="margin-top: 0.7rem; margin-bottom: 0.35rem;">
        GRANULAR ENTITLEMENT TOKENS · 4 TENANT ORGANIZATIONS · 6 PRESENTABLE MODULES
      </p>
      <h1 style="font-size: clamp(1.8rem, 3.2vw, 2.6rem); font-weight: 900; margin-bottom: 0.6rem;">
        TAYCO LLC — <span class="serif-italic" style="color: var(--accent-primary);">Module-Scoped</span> Guest Invitation Console
      </h1>
      <p style="color: #cbd5e1; max-width: 780px; margin-bottom: 1.4rem;">
        Generate custom invitation links (<code>INV-TAYCO-...</code>) by selecting the exact modules (out of 6) each client, REIT investor, or CPA auditor is authorized to view. Restricted modules remain completely hidden from the guest navigation bar.
      </p>
      <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
        <a href="/portal" class="btn-gold">🚀 Open Live Interactive Command Portal (/portal) →</a>
        <a href="/astro-preview/index.html" class="btn-outline">📊 Back to Telemetry Overview</a>
      </div>
    </section>

    <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.15rem;">
      {invitations.map((inv) => (
        <article class="bento-card">
          <div class="preview-orbits"></div>
          <div class="mono-eyebrow" style="margin-bottom: 0.35rem;">
            {inv.code}
          </div>
          <div style="font-size: 0.75rem; font-weight: 800; color: #34d399; margin-bottom: 0.4rem;">
            {inv.ratio} · {inv.role}
          </div>
          <h2 style="font-size: 1rem; font-weight: 800; margin-bottom: 0.65rem;">
            {inv.recipient}
          </h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1rem;">
            {inv.modules.map((mod) => (
              <span class="badge" style="font-size: 0.64rem;">{mod}</span>
            ))}
          </div>
          <a href={`/portal?invite=${inv.code}`} class="btn-outline" style="display: inline-block; font-size: 0.76rem;">
            Simulate Token in /portal →
          </a>
        </article>
      ))}
    </section>
  </main>
</TaycoLayout>
