---
import TaycoLayout from "../layouts/TaycoLayout.astro";
---
<TaycoLayout title="Multi-Tenant Portal Astro 5">
  <main style="max-width: 1100px; margin: 0 auto; padding: 2.5rem 1.5rem;">
    <div style="background: #0F2040; border: 1px solid #C9A84C; border-radius: 1rem; padding: 2rem;">
      <span class="badge">🔐 Multi-Tenant Guest Invitation Architecture</span>
      <h1 style="font-size: 2rem; font-weight: 900; margin-top: 0.75rem; margin-bottom: 0.5rem;">
        TAYCO LLC — Module-Scoped Guest Invitation Console
      </h1>
      <p style="color: #cbd5e1; margin-bottom: 1.5rem;">
        Generate custom invitation links (<code>INV-TAYCO-...</code>) by checking the exact modules (out of 6) you want to showcase to each client, lender, or CPA firm.
      </p>
      <a href="/portal" class="btn-gold">🚀 Launch Interactive Invitation Console (/portal) →</a>
    </div>
  </main>
</TaycoLayout>
