---
import TaycoLayout from "../layouts/TaycoLayout.astro";

const modules = [
  {
    code: "MOD-01",
    title: "🤝 1. Commercial CRM, Bid Pipeline & Subcontractor Registry",
    kpi: "$5.88M Pipeline · 5 Projects · 29 Trades",
    desc: "Connected in real time with /estimate, /investor, /vendor-application, and Takeoff Pro CSI-32 budgets.",
    href: "/portal?tab=MOD_CRM_BIDS",
  },
  {
    code: "MOD-02",
    title: "👷 2. Construction Payroll, Field Crews & Davis-Bacon WH-347",
    kpi: "$213,299.26 Labor Budget · 6,536.0 MH",
    desc: "Deterministic calculation of Base Wages ($171,324.71), FICA 7.65% ($13,106.34), FUTA/SUTA ($5,825.04), and Workers' Comp ($23,043.17).",
    href: "/portal?tab=MOD_PAYROLL_CREW",
  },
  {
    code: "MOD-03",
    title: "📗 3. QuickBooks Accounting Sync, 8 POs & AIA G702/G703",
    kpi: "$855,525.23 GMP · $184,892.70 Net AIA G702",
    desc: "Automated CSI-32 mapping to QuickBooks accounts (1200 A/R, 1210 10% Retainage $51,501.13, 5200 8 Material POs $375,012.51) + .IIF/.QBO export.",
    href: "/portal?tab=MOD_QUICKBOOKS_ERP",
  },
  {
    code: "MOD-04",
    title: "🏛️ 4. Multi-State Tax Engine (9 States), W-9/COI & IRS 1099-NEC",
    kpi: "WI · IL · IA · IN · MN · MI · MO · TX · ND",
    desc: "Separates taxable materials ($375,012.51) from exempt field labor ($213,299.26), Tax-Exempt certificates, W-9/COI compliance gate, and Form 941.",
    href: "/portal?tab=MOD_TAX_COMPLIANCE",
  },
];
---
<TaycoLayout title="TAYCO LLC — Astro 5 + Takeoff Pro Enterprise Suite">
  <main style="max-width: 1240px; margin: 0 auto; padding: 2.5rem 1.5rem;">
    <section style="background: linear-gradient(145deg, #08121F 0%, #0F2040 55%, #142B54 100%); border: 1px solid rgba(201,168,76,0.4); border-radius: 1.25rem; padding: 2.5rem;">
      <div style="display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 1rem;">
        <span class="badge">★ Astro 5 Zero-JS Overhead + Interactive Islands</span>
        <span class="badge">WI · IL · IA · IN · MN · MI · MO · TX · ND</span>
      </div>
      <h1 style="font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 900; line-height: 1.1; margin-bottom: 0.85rem;">
        TAYCO LLC — Full-Service Construction &amp; <span style="color: #C9A84C;">Multi-Tenant ERP Suite</span>
      </h1>
      <p style="color: #cbd5e1; max-width: 780px; font-size: 1rem; margin-bottom: 1.75rem;">
        Static Astro 5 architecture engineered for instant Commercial and Residential SEO performance, integrated with the Multi-Tenant Module-Scoped Client Portal and live <strong>Takeoff Pro (:8085)</strong> bridge.
      </p>
      <div style="display: flex; flex-wrap: wrap; gap: 0.85rem;">
        <a href="/portal" class="btn-gold">🔐 Enter Multi-Tenant Portal &amp; Module Invitations →</a>
        <a href="/commercial" class="btn-outline">🏢 Commercial Division</a>
        <a href="/residential" class="btn-outline">🏠 Residential Division</a>
        <a href="/estimate" class="btn-outline">🧮 Instant Sq Ft Cost Estimator</a>
      </div>
    </section>

    <section style="margin-top: 2.25rem;">
      <h2 style="font-size: 1.35rem; font-weight: 900; color: #C9A84C; margin-bottom: 1rem;">
        The 4 Enterprise Modules Connected to Takeoff Pro (Module-Scoped Client Demos)
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 1.25rem;">
        {modules.map((m) => (
          <a
            href={m.href}
            style="display: block; background: #0F2040; border: 1px solid rgba(201,168,76,0.3); border-radius: 1rem; padding: 1.5rem; transition: transform 0.2s;"
          >
            <div style="font-size: 0.72rem; font-weight: 800; color: #C9A84C; text-transform: uppercase; margin-bottom: 0.35rem;">
              {m.code} · {m.kpi}
            </div>
            <h3 style="font-size: 1.08rem; font-weight: 800; color: #fff; margin-bottom: 0.6rem;">
              {m.title}
            </h3>
            <p style="font-size: 0.85rem; color: #cbd5e1; margin-bottom: 1rem;">
              {m.desc}
            </p>
            <span style="font-size: 0.8rem; font-weight: 800; color: #C9A84C;">
              Open Module in Portal →
            </span>
          </a>
        ))}
      </div>
    </section>
  </main>
</TaycoLayout>
