---
import AstroPortalLayout from "../../layouts/AstroPortalLayout.astro";

const invitations = [
  {
    code: "INV-TAYCO-FULL-SUITE",
    role: "TENANT_ADMIN",
    ratio: "6/6 Modules Enabled",
    recipient: "TAYCO LLC Executive Board & Master Admin",
    modules: ["Takeoff Pro", "CRM & Bids", "Payroll WH-347", "QuickBooks ERP", "9-State Tax", "Investor Portal"],
  },
  {
    code: "INV-DEMO-CRM-TAKEOFF",
    role: "ESTIMATOR_SALES_DEMO",
    ratio: "2/6 Modules Enabled",
    recipient: "Invited Commercial Client / Estimator Showcase",
    modules: ["Takeoff Pro", "CRM & Bids"],
  },
  {
    code: "INV-CPA-FINANCE-TAX",
    role: "CPA_ACCOUNTING_AUDITOR",
    ratio: "3/6 Modules Enabled",
    recipient: "External CPA & Multi-State Tax Audit Firm",
    modules: ["Payroll WH-347", "QuickBooks ERP", "9-State Tax"],
  },
  {
    code: "INV-INVESTOR-BOARD",
    role: "INVESTOR_PARTNER",
    ratio: "3/6 Modules Enabled",
    recipient: "Midwest Commercial REIT & Turnkey Partners",
    modules: ["CRM & Bids", "QuickBooks ERP", "Investor Portal"],
  },
];
---
<AstroPortalLayout title="Multi-Tenant Invitation Console — TAYCO Executive Command">
  <main style="max-width: 1180px; margin: 0 auto; padding: 2.25rem 1.5rem;">
    <section class="bento-card" data-response-kind="surface" style="padding: 2.2rem; margin-bottom: 1.5rem;">
      <span class="response-wash" aria-hidden="true"></span>
      <div class="preview-orbits"></div>

      <!-- Rotating Orbital Stamp (.orbital-caption) -->
      <div class="orbital-caption" aria-hidden="true">
        <svg viewBox="0 0 100 100">
          <defs>
            <path id="tayco-portal-orbital-path" d="M50,50m-36,0a36,36 0 1,1 72,0a36,36 0 1,1-72,0" />
          </defs>
          <text>
            <textPath href="#tayco-portal-orbital-path">TAYCO EDITORIAL · MULTI-TENANT PORTAL · </textPath>
          </text>
        </svg>
        <span>✳</span>
      </div>

      <span class="badge">🔐 TAYCO Executive Command · Module-Scoped Access Control</span>
      <p class="mono-eyebrow" style="margin-top: 0.7rem; margin-bottom: 0.35rem;">
        GRANULAR ENTITLEMENT TOKENS · 4 TENANT ORGANIZATIONS · 6 PRESENTABLE MODULES
      </p>
      <h1 style="font-size: clamp(1.8rem, 3.2vw, 2.6rem); font-weight: 900; margin-bottom: 0.6rem; max-width: 880px;">
        TAYCO LLC — <span class="serif-italic" style="color: var(--gold-bright);">Module-Scoped</span> Guest Invitation Console
      </h1>
      <p style="color: #cbd5e1; max-width: 780px; margin-bottom: 1.4rem;">
        Generate custom invitation links (<code>INV-TAYCO-...</code>) by selecting the exact modules (out of 6) each client, REIT investor, or CPA auditor is authorized to view in <strong>TAYCO Executive Command</strong>. Restricted modules remain completely hidden from the guest navigation bar.
      </p>
      <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
        <a href="/portal" class="btn-gold" data-magnetic>🚀 Open Live TAYCO Executive Command (/portal) →</a>
        <a href="/astro-preview/index.html" class="btn-outline" data-magnetic>📊 Back to TAYCO Editorial Overview</a>
      </div>
    </section>

    <!-- Editorial Italic Kinetic Marquee Ticker (.tayco-editorial-ticker) -->
    <div class="tayco-editorial-ticker" aria-hidden="true">
      <div>
        <span>TAYCO Executive Command · Role-Scoped Multi-Tenant Governance</span>
        <i>✳</i>
        <span>Zero-Trust Module Entitlements · CPA Audit · REIT Partner · Commercial Estimator</span>
        <i>✳</i>
        <span>TAYCO Editorial Surface Physics · Live 3D Tilt &amp; Specular Wash</span>
        <i>✳</i>
        <span>TAYCO Executive Command · Role-Scoped Multi-Tenant Governance</span>
        <i>✳</i>
      </div>
    </div>

    <!-- SVG Horizon Wave Divider (.chromatic-horizon) -->
    <div class="chromatic-horizon" aria-hidden="true">
      <svg viewBox="0 0 1440 140" preserveAspectRatio="none">
        <path class="horizon-land" d="M0 83 C260 8 390 133 720 70 S1140 10 1440 70 V140 H0Z" />
        <path class="horizon-trace a" d="M-80 60 C260 -30 390 122 720 50 S1140 -15 1520 50" />
        <path class="horizon-trace b" d="M-80 32 C260 -60 400 92 720 25 S1140 -40 1520 25" />
      </svg>
    </div>

    <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.15rem; margin-bottom: 1.75rem;">
      {invitations.map((inv) => (
        <article class="bento-card" data-response-kind="surface">
          <span class="response-wash" aria-hidden="true"></span>
          <div class="preview-orbits"></div>
          <div class="mono-eyebrow" style="margin-bottom: 0.35rem;">
            {inv.code}
          </div>
          <div style="font-size: 0.75rem; font-weight: 800; color: var(--construction-orange); margin-bottom: 0.4rem;">
            {inv.ratio} · {inv.role}
          </div>
          <h2 style="font-size: 1rem; font-weight: 800; color: #F4F2EA; margin-bottom: 0.65rem;">
            {inv.recipient}
          </h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1rem;">
            {inv.modules.map((mod) => (
              <span class="badge" style="font-size: 0.64rem;">{mod}</span>
            ))}
          </div>
          <a href={`/portal?invite=${inv.code}`} class="btn-outline" data-magnetic style="display: inline-block; font-size: 0.76rem;">
            Simulate Token in /portal →
          </a>
        </article>
      ))}
    </section>

    <!-- Warm Editorial Ivory (#F4F2EA) Contrast Section -->
    <section class="editorial-ivory-section">
      <div class="mono-eyebrow" style="margin-bottom: 0.35rem;">
        TAYCO EDITORIAL · MULTI-TENANT SECURITY GUARANTEE (#F4F2EA)
      </div>
      <h2 style="font-size: 1.3rem; font-weight: 900; color: #070E1A; margin-bottom: 0.4rem;">
        Cryptographic Module Isolation for <span class="serif-italic" style="color: #1B3A6B;">External Auditors &amp; Capital Partners</span>
      </h2>
      <p style="font-size: 0.86rem; color: #0F2040;">
        Each TAYCO LLC invitation token binds session scope directly to the authorized ERP modules—ensuring estimators, CPAs, and REIT boards see only their designated operational telemetry.
      </p>
    </section>
  </main>
</AstroPortalLayout>
